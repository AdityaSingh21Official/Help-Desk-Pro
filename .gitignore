# ==========================================
# 📦 Node / Package Managers
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ==========================================
# 🎨 Build / Compiled Assets
# ==========================================
# Tailwind builds your output.css from input.css on the fly. 
# Many developers choose to ignore it so it doesn't clutter git history
src/output.css

# Log files generated by build tools
.eslintcache
.stylelintcache

# ==========================================
# 🔑 Security / Environment Variables
# ==========================================
# Never commit credentials, API keys, or secrets!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ==========================================
# 💻 Operating System (OS) Junk Files
# ==========================================
# Windows specific
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
[Dd]esktop.ini

# macOS specific
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux specific
*~
.fuse_hidden*
.directory
.trash/

# ==========================================
# 🛠️ IDEs and Editors
# ==========================================
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# WebStorm / IntelliJ / JetBrains
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# 📊 Crash Logs & Testing
# ==========================================
logs
*.log
cov/
coverage/
.nyc_output
